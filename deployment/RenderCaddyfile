{
	admin off
	auto_https off
	persist_config off
	log {
		level ERROR
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
}

:{$PORT:10000} {
	encode zstd gzip
	handle /_deployment/ready {
		reverse_proxy 127.0.0.1:8000
	}
	handle /stripe/webhook {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:8501
	}
}
