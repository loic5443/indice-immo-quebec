# Copy to .env on the server. Never commit actual secrets.
IMMORADAR_HOSTNAME=your-domain.example
IMMORADAR_PUBLIC_URL=https://your-domain.example
IMMORADAR_BILLING_ENABLED=0
IMMORADAR_BILLING_MODE=test
# Clé serveur restreinte recommandée (rk_test_ / rk_live_); sk_ reste compatible.
# Les bacs à sable temporaires utilisent aussi rkcs_test_ (test uniquement).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Optional transactional account recovery (separate from alerts/marketing).
IMMORADAR_AUTH_EMAIL_ENABLED=0
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
IMMORADAR_ALERT_DELIVERY_ENABLED=false
# Optional operations worker. Backups must also be copied off the server.
IMMORADAR_OPERATIONS_ENABLED=0
IMMORADAR_BACKUPS_ENABLED=0
IMMORADAR_OPERATIONS_INTERVAL_SECONDS=86400
IMMORADAR_BACKUP_DIRECTORY=/app/var/backups
